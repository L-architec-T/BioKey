    <string name="device_detail_delete_confirm_body">This only removes the pairing on this phone. The PCBU protocol has no \"unpair\" message, so remember to also remove this device on the PC side if needed.</string>

    <string name="pairing_scan_title">Pair a PC</string>
    <string name="pairing_scan_instructions">Scan the QR code shown by BioKey on your computer (Pair button).</string>
